# ---- NextAuth ----
# Ganti dengan domain Anda setelah setup SSL
NEXTAUTH_URL=https://DOMAIN_ANDA

# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=GANTI_DENGAN_STRING_RANDOM_MINIMAL_32_KARAKTER

# ---- Database ----
